@model ProductCategory.Models.Product

@{ ViewData["Title"] = "Delete Product"; }

<h1>Delete Product</h1>
<h3>Are you sure you want to delete this product?</h3>
<hr />
<dl class="row">
    <dt class="col-sm-2">Name</dt><dd class="col-sm-10">@Model.ProductName</dd>
    <dt class="col-sm-2">Price</dt><dd class="col-sm-10">@Model.ProductPrice.ToString("0.00")</dd>
    <dt class="col-sm-2">Category</dt><dd class="col-sm-10">@ViewBag.CategoryName</dd>
</dl>
<form asp-action="DeleteConfirmed" asp-route-id="@Model.ProductId" method="post">
    <input type="hidden" asp-for="ProductId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
