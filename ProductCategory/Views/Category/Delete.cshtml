@model ProductCategory.Models.Category

@{ ViewData["Title"] = "Delete Category"; }

<h1>Delete Category</h1>
<div asp-validation-summary="All" class="text-danger"></div>
<h3>Are you sure you want to delete this category?</h3>
<p><strong>@Model.CategoryName</strong> (@ViewBag.ProductCount product(s))</p>
@if ((int)ViewBag.ProductCount > 0)
{
    <p class="text-warning">Move or delete the products in this category before deleting it.</p>
}
else
{
    <form asp-action="DeleteConfirmed" asp-route-id="@Model.CategoryId" method="post">
        <input type="hidden" asp-for="CategoryId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
}
