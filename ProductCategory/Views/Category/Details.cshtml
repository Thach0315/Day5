@model ProductCategory.Models.Category

@{ ViewData["Title"] = "Category Details"; }

<h1>Category Details</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">CategoryId</dt><dd class="col-sm-10">@Model.CategoryId</dd>
    <dt class="col-sm-2">CategoryName</dt><dd class="col-sm-10">@Model.CategoryName</dd>
    <dt class="col-sm-2">Products</dt><dd class="col-sm-10">@ViewBag.ProductCount</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.CategoryId">Edit</a> |
<a asp-action="Index">Back to List</a>
